<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS + iisnode config for SQL Management (Node/Express).

  IIS runs node.exe in-process via the iisnode module. Requests are rewritten
  to server.js; Express serves both the API and the static UI in public/.

  Requires on the server (one-time, machine-wide):
    - Node.js (node.exe on PATH)
    - IIS with the iisnode module  (https://github.com/Azure/iisnode/releases)
    - URL Rewrite module           (https://www.iis.net/downloads/microsoft/url-rewrite)
  See deploy\IIS-HOSTING-GUIDE.md for full setup.

  Point an IIS website's physical path at this folder (D:\KS\SQL).
-->
<configuration>
  <system.webServer>

    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Don't interfere with the node-inspector debug endpoint. -->
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^server.js\/debug[\/]?" />
        </rule>

        <!-- Everything else goes to the Node entry point. Express serves the
             static UI from public/ and the /api routes itself. -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Keep source, env, logs, and node internals from being served as files. -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="iisnode" />
          <add segment="logs" />
          <add segment="deploy" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".bak" allowed="false" />
        </fileExtensions>
        <!-- Allow large request bodies (e.g. big paste-as-VALUES payloads). -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>

    <!-- Let Node's own error responses pass through untouched. -->
    <httpErrors existingResponse="PassThrough" />

    <iisnode
      nodeProcessCountPerApplication="1"
      watchedFiles="web.config;*.js"
      loggingEnabled="true"
      logDirectory="iisnode"
      devErrorsEnabled="false"
      node_env="production" />

  </system.webServer>
</configuration>

# SQL Management — copy to .env and fill in your own values
# .env is gitignored; profiles you save in the UI are stored in browser localStorage.

# ── MSSQL default profile (used on server startup) ──
MSSQL_SERVER=localhost
MSSQL_USER=sa
MSSQL_PASSWORD=
# Trust self-signed certs (default true for local dev). Set false in prod.
MSSQL_TRUST_SERVER_CERT=true
# Force TLS encryption (default false). Set true for cloud SQL Server.
MSSQL_ENCRYPT=false

# ── PostgreSQL default profile (used on server startup) ──
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=

# ── Optional: pre-select a database in each panel on first load ──
# MSSQL_DEFAULT_DB=
# PG_DEFAULT_DB=

# ── Server bind ──
# Default 127.0.0.1 — only your machine can reach the UI/API.
# Set HOST=0.0.0.0 to expose on the LAN (no auth, so only do this on a trusted network).
HOST=127.0.0.1
PORT=3000

# ── Query timeout in milliseconds (default 60000 = 60s) ──
QUERY_TIMEOUT_MS=60000

# Maximum query-text characters stored in each audit-log entry (default 4000)
AUDIT_QUERY_MAX=4000

# ── How long an idle browser session keeps its connections (default 8h) ──
# Each browser gets its own live connections, kept in server memory and reclaimed
# once it has made no request for this long. An open tab polls continuously, so
# only a closed one goes idle. Lower it if many people share the server and you
# want pooled connections released sooner.
SESSION_TTL_MS=28800000
